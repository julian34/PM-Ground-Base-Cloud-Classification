<mxCell id="n47" value="&lt;b&gt;Legenda &amp; modifikasi vs DenseNet-121&lt;/b&gt;&lt;br&gt;&lt;br&gt;■ biru = komponen standar DenseNet-121 (stem, depth 6/12/24/16, transisi)&lt;br&gt;■ oranye = modifikasi CloudDenseNet (SE, SCConv, SpatialAttnBR, ND, Top Block)&lt;br&gt;■ hijau = fitur fisik: peta λ rasio Biru/Merah&lt;br&gt;■ ungu = input / tensor keluaran    ■ merah = fungsi loss&lt;br&gt;&lt;br&gt;• Pertumbuhan channel: 64 → 256 → 512 → 1024 → 1024 (+32/layer)&lt;br&gt;• Spasial: 224 → 56 → 28 → 14 → 7&lt;br&gt;• SEBlock: GAP→Conv1×1(C→C/16)→ReLU→Conv1×1→Sigmoid (r=16, init≈identitas)&lt;br&gt;• SpatialAttnBR: a=sigmoid(Conv7×7([mean, max, λ])); out = x·a&lt;br&gt;• SCConv: cosine ternormalisasi, dipaksa fp32 (stabil di AMP), padding reflect&lt;br&gt;• ND: (P−Q)/(P+Q) — pembaca dinolkan saat init → awal = ImageNet murni&lt;br&gt;• Transfer learning ImageNet: fine-tuning 6 fase (beku → buka block 3-4 → full)&lt;br&gt;• Optimasi: AdamW (wd=1e-2), grad clip norma 5.0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;align=left;verticalAlign=top;fontSize=10;fontColor=#1a1a1a;spacing=6;fillColor=#fafafa;strokeColor=#9a9a9a;" vertex="1" parent="1"><mxGeometry x="600" y="930" width="520" height="300" as="geometry"/></mxCell>
<mxCell id="n48" value="Arsitektur CloudDenseNet" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="90" y="-20" width="700" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
