<mxCell id="n27" value="&lt;b&gt;Peta λ B/R — fitur sadar-fisika  (spectral.lambda_relatif)&lt;/b&gt;&lt;br&gt;dihitung di siapkan_batch pada citra [0,1] (belum dinormalisasi)&lt;br&gt;λ_raw = (B − R) / (B + R + eps)   (&gt;0 langit, &lt;0 awan)&lt;br&gt;λ = 0.5·tanh((λ_raw − median)/0.5) · valid_mask&lt;br&gt;valid_mask buang piksel gelap (&lt;0.10) &amp; silau (&gt;0.97)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;spacing=4;fillColor=#d6efe3;strokeColor=#2e9b6b;" vertex="1" parent="1"><mxGeometry x="620" y="40" width="480" height="150" as="geometry"/></mxCell>
<mxCell id="n28" value="λ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2e9b6b;strokeWidth=1.6;fontSize=10;fontColor=#555555;fontStyle=2;dashed=1;" edge="1" parent="1" source="n27" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n29" value="λ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2e9b6b;strokeWidth=1.6;fontSize=10;fontColor=#555555;fontStyle=2;dashed=1;" edge="1" parent="1" source="n27" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n30" value="λ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2e9b6b;strokeWidth=1.6;fontSize=10;fontColor=#555555;fontStyle=2;dashed=1;" edge="1" parent="1" source="n27" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n31" value="λ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2e9b6b;strokeWidth=1.6;fontSize=10;fontColor=#555555;fontStyle=2;dashed=1;" edge="1" parent="1" source="n27" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n32" value="&lt;b&gt;DenseLayer — unit penyusun tiap block&lt;/b&gt;&lt;br&gt;output tiap layer = growth_rate (32) = SCConv(24) + ND(8)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;spacing=4;fillColor=#fafafa;strokeColor=#9a9a9a;" vertex="1" parent="1"><mxGeometry x="600" y="430" width="520" height="470" as="geometry"/></mxCell>
<mxCell id="n33" value="x  (concat semua fitur sebelumnya)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;spacing=4;fillColor=#dbe7f3;strokeColor=#4a74a8;" vertex="1" parent="1"><mxGeometry x="680" y="500" width="360" height="40" as="geometry"/></mxCell>
<mxCell id="n34" value="BN → ReLU → Conv 1×1 (in→4k=128)   [bottleneck Hₗ]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;spacing=4;fillColor=#dbe7f3;strokeColor=#4a74a8;" vertex="1" parent="1"><mxGeometry x="680" y="560" width="360" height="45" as="geometry"/></mxCell>
<mxCell id="n35" value="BN → ReLU" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;spacing=4;fillColor=#dbe7f3;strokeColor=#4a74a8;" vertex="1" parent="1"><mxGeometry x="680" y="625" width="360" height="35" as="geometry"/></mxCell>
<mxCell id="n36" value="SE(128)  — atensi channel bottleneck" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;spacing=4;fillColor=#ffe2c2;strokeColor=#d9822b;" vertex="1" parent="1"><mxGeometry x="680" y="685" width="360" height="40" as="geometry"/></mxCell>
<mxCell id="n37" value="SCConv 3×3&lt;br&gt;(128 → k−nd = 24)&lt;br&gt;jalur utama" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontSize=9;fontColor=#1a1a1a;spacing=4;fillColor=#ffe2c2;strokeColor=#d9822b;" vertex="1" parent="1"><mxGeometry x="660" y="760" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="n38" value="Conv 3×3 (128→2·nd=16)&lt;br&gt;→ softplus → P, Q&lt;br&gt;(P−Q)/(P+Q+eps) = ND (8 ch)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontSize=9;fontColor=#1a1a1a;spacing=4;fillColor=#ffe2c2;strokeColor=#d9822b;" vertex="1" parent="1"><mxGeometry x="880" y="760" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="n39" value="concat[ SCConv(24), ND(8) ] = 32 = growth_rate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;spacing=4;fillColor=#e7e2f3;strokeColor=#6f5fa6;" vertex="1" parent="1"><mxGeometry x="680" y="850" width="360" height="40" as="geometry"/></mxCell>
